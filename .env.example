# ── Application ────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-a-long-random-string-at-least-32-chars
ENVIRONMENT=development

# ── PostgreSQL ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mabscessus_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DB=mabscessus_mongo
# Leave blank for no auth (development only)
MONGODB_USER=
MONGODB_PASSWORD=

# ── File Storage ───────────────────────────────────────────────────────────────
UPLOAD_DIR=/tmp/uploads
MAX_FILE_SIZE_MB=500

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (JSON array format)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:80","http://localhost"]

# ── Frontend ───────────────────────────────────────────────────────────────────
# API URL used by the React app (leave blank to use relative /api/v1 via nginx)
REACT_APP_API_URL=

# ── Email (optional) ──────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=

# ── AWS S3 (optional) ─────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
