# ===============================================
# M. abscessus Tolerance Platform - Environment Variables
# ===============================================
# For Docker development, copy this to .env and update as needed

# ===============================================
# Application Settings
# ===============================================
ENVIRONMENT=development
SECRET_KEY=your-super-secret-key-change-this-in-production-use-a-long-random-string
DEBUG=True

# ===============================================
# PostgreSQL Configuration (Docker Service Name: postgres)
# ===============================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mabscessus_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# ===============================================
# MongoDB Configuration (Docker Service Name: mongodb)
# ===============================================
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DB=mabscessus_mongo
MONGODB_USER=mongoadmin
MONGODB_PASSWORD=mongo123

# ===============================================
# Backend Configuration
# ===============================================
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=500
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:80","http://localhost"]

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===============================================
# Frontend Configuration
# ===============================================
# API URL used by React app (leave empty to use relative /api/v1 via nginx)
REACT_APP_API_URL=

# ===============================================
# Optional - Email Configuration
# ===============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=

# ===============================================
# Optional - AWS S3 Configuration
# ===============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
